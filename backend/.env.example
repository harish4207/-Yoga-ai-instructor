# ==============================================================================
# AI Yoga Coach — Backend Production Environment Variables
# ==============================================================================

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.itxrjm7.mongodb.net/ai-yoga-coach?retryWrites=true&w=majority

# JWT Authentication Secret & Lifetime
JWT_SECRET=your_production_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Server Port
PORT=5000

# Allowed CORS Origins (Comma-separated for multiple origins e.g. Vercel frontend)
ALLOWED_ORIGINS=https://ai-yoga-coach.vercel.app,http://localhost:5173

# Node Environment
NODE_ENV=production

# Sarvam TTS API Key (Used strictly for offline/manual asset generation — ZERO runtime calls)
SARVAM_API_KEY=your_sarvam_api_key_here

# CV Service URL (Optional if using Python Flask service on Render/Railway)
CV_SERVICE_URL=http://localhost:5001
